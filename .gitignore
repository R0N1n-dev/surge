# ---------------------------------------------------------------- dependencies
node_modules/
bun.lockb
package-lock.json
yarn.lock

# --------------------------------------------------------------------- builds
dist/
build/
out/
.gradle/
*.tsbuildinfo

# ---------------------------------------------------------------- android/
# The platform project is GENERATED, not tracked. `cap add android` unpacks it
# from the Capacitor CLI template, and `npm run android:prep` (also executed by
# postinstall) applies Surge's maintained overrides: compileSdk/targetSdk 36,
# AGP 8.13, the Kotlin + Chaquopy plugin classpaths, the Gradle wrapper and
# capacitor.settings.gradle.
#
# It used to be a gitlink (mode 160000) with no .gitmodules: a clone got an
# EMPTY android/ folder, which both blocked `cap add android` ("platform already
# exists") and made it impossible to ever commit `android/gradlew`.
android/
plugins/*/android/build/
plugins/*/android/.gradle/
*.apk
*.aab
*.ap_
*.dex
*.class

# ------------------------------------------------------------------ tooling
__pycache__/
*.py[cod]
.venv/
venv/

# ----------------------------------------------------------------------- IDEs
.idea/
.vscode/
*.iml
*.swp
.DS_Store
Thumbs.db

